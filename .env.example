# Copy to .env and fill in. .env is git-ignored; this file is not.
# Only the judge (layer 3, `openapi-analysis judge`) needs any of these.

# Provider: openrouter | openai — the model default follows it (see config/settings.py)
JUDGE_PROVIDER=openrouter
# JUDGE_MODEL=openai/gpt-5.6-luna      # override; default per provider
JUDGE_TEMPERATURE=0
# "none" OMITS the reasoning parameter (the model reasons as it would by default);
# low | medium | high set it explicitly.
JUDGE_REASONING_EFFORT=none

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# Qdrant (shared with the sibling repos)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
